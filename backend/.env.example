# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/mansaathi
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mansaathi
MONGO_URI=mongodb://127.0.0.1:27017/mansaathi

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - the URL your frontend runs on
CLIENT_URL=http://localhost:5173
